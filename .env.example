# Secret, das Jira Automation im Header X-Webhook-Secret mitschickt.
# Erzeugen z.B. mit: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# Eigener Key für GET /stats (Header X-API-Key). Muss sich vom WEBHOOK_SECRET unterscheiden.
STATS_API_KEY=

# Pfad zur SQLite-Datei (optional, Standard lokal: jira.db, im Docker-Image: /data/jira.db).
# Für Docker NICHT setzen, sonst landet die DB außerhalb des Volumes.
# DB_PATH=jira.db
